{ lib, pkgs, ... }:

{
  # Load machine-specific settings when present. This file is not managed by chezmoi.
  imports = lib.optional (builtins.pathExists ./local.nix) ./local.nix;

  nix.settings.experimental-features = "nix-command flakes";

  system.primaryUser = "{{ .chezmoi.username }}";

  users.users.{{ .chezmoi.username }} = {
    name = "{{ .chezmoi.username }}";
    home = "{{ .chezmoi.homeDir }}";
  };

  system.defaults.NSGlobalDomain = {
    KeyRepeat = 1;
    InitialKeyRepeat = 15;
    "com.apple.swipescrolldirection" = true;
  };

  system.defaults.".GlobalPreferences"."com.apple.mouse.scaling" = 3.0;

  system.defaults.CustomUserPreferences.NSGlobalDomain = {
    "com.apple.scrollwheel.scaling" = 0.75;
    "com.apple.mouse.doubleClickThreshold" = 0.5;
  };

  system.stateVersion = 7;
}
